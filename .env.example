# ============================================================================
# SPEND ANALYTICS DASHBOARD - ENVIRONMENT VARIABLES
# ============================================================================

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/spend_analytics
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# SERVER
NODE_ENV=development
SERVER_PORT=3001
API_BASE_URL=http://localhost:3001

# FRONTEND
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENV=development

# LOGGING
LOG_LEVEL=debug

# SECURITY
JWT_SECRET=your-secret-key-change-in-production
CORS_ORIGIN=http://localhost:3000

# BATCH JOBS
ENABLE_CATEGORIZATION_JOB=true
ENABLE_ANALYTICS_JOB=true
ENABLE_INSIGHTS_JOB=true
BATCH_SCHEDULE_CRON=0 2 * * * # 2 AM daily

# FEATURE FLAGS
ENABLE_SUBSCRIPTIONS_DETECTION=true
ENABLE_FUZZY_MERCHANT_MATCHING=true
ENABLE_INSIGHTS_ENGINE=true

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
DEBUG=spend-analytics:*

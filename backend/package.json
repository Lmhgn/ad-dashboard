{
  "name": "spend-analytics-backend",
  "version": "0.0.1",
  "description": "Spend Analytics Dashboard Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "db:init": "ts-node scripts/init-db.ts",
    "db:import-csv": "ts-node scripts/import-csv.ts",
    "db:reset": "ts-node scripts/reset.ts",
    "process-transactions": "ts-node scripts/process-transactions.ts",
    "compute-analytics": "ts-node scripts/compute-analytics.ts",
    "worker:process": "ts-node src/workers/processingWorker.ts --schedule",
    "worker:analytics": "ts-node src/workers/analyticsWorker.ts --schedule",
    "worker:insights": "ts-node src/workers/insightWorker.ts"
  },
  "keywords": [
    "fintech",
    "spend-tracking",
    "analytics",
    "dashboard"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "js-levenshtein": "^1.1.6",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "natural": "^6.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/js-levenshtein": "^1.1.3",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
